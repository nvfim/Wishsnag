# WishSnag build-time configuration (copy to .env.local). All values are OPTIONAL.
# WishSnag works fully without them; users can also enter these in Settings → Cloud sync.

# Your Supabase project URL and *anon (public)* key — safe to ship; data is protected by RLS.
# NEVER put the service-role key, eBay keys or Resend keys here: those belong in
# Supabase Edge Function secrets (see docs/CLOUD.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
